# ============================================================
#  .gitignore for Appium Android Automation Framework
# ============================================================

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- Maven ---
target/

# --- Test Output & Reports ---
test-output/
!test-output/.gitkeep
.allure/
allure-results/
allure-report/

# --- Screenshots & Videos ---
screenshots/
screenshot/
*.png
videos/
*.mp4

# --- Log Files ---
*.log
logs/

# --- App Binaries ---
*.app/
*.app
.Spotlight-V8
.Trashes

# --- System ---
Thumbs.db
.DS_Store
.vscode/
antigravity-testing-kit-main/
RULE_GLOBAL.md

# --- Environment ---
# Do NOT commit sensitive config — use environment variables or CI secrets
# config.properties (only if it contains real passwords — for now it's fine)

# --- APK files ---
*.apk
*.aab
